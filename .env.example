# ─── Database (PostgreSQL) ───
# Local development:
DATABASE_URL="postgresql://postgres:password@localhost:5432/makanview"
# Production (with connection pooling):
# DATABASE_URL="postgresql://user:password@db-host:5432/makanview?connection_limit=20&pool_timeout=10"
# AWS RDS example:
# DATABASE_URL="postgresql://makanview:StrongPass@makanview-db.xxx.ap-south-1.rds.amazonaws.com:5432/makanview?sslmode=require"

# ─── Authentication ───
# Generate a strong secret: openssl rand -base64 32
AUTH_SECRET="CHANGE-ME-GENERATE-A-STRONG-SECRET"

# ─── Admin Account ───
ADMIN_EMAIL="admin@makanview.com"
ADMIN_PASSWORD="CHANGE-ME-USE-A-STRONG-PASSWORD"

# ─── WhatsApp ───
# Digits only with country code, e.g. 9715XXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# ─── SMTP (Email Notifications) ───
# Leave empty to disable email notifications
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
# Email address that receives lead notifications (defaults to SMTP_USER)
LEAD_NOTIFICATION_EMAIL=""

# ─── AWS S3 (Production Image Storage) ───
# In production (NODE_ENV=production), images upload to S3 instead of local disk.
# Leave AWS_S3_BUCKET empty to keep using local disk even in production.
AWS_S3_BUCKET=""
AWS_S3_REGION="ap-south-1"
AWS_S3_ACCESS_KEY_ID=""
AWS_S3_SECRET_ACCESS_KEY=""
# Optional: CloudFront CDN URL for serving images (e.g. https://cdn.makanview.com)
AWS_S3_CDN_URL=""

# ─── Site URL (for production) ───
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
