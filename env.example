DATABASE_URL="file:./dev.db"

# Used to sign admin session cookies (use a long random string)
AUTH_SECRET="change-me-to-a-long-random-string"

# Initial admin (used by `npm run db:seed`)
ADMIN_EMAIL="admin@makanviewproperties.com"
ADMIN_PASSWORD="change-me"

# Public contact (optional; used for WhatsApp CTA)
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# Optional SMTP for contact form notifications (if unset, leads are still saved to DB)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Makanview Properties <no-reply@makanviewproperties.com>"
LEADS_TO_EMAIL="makanviewproperties@gmail.com"

# AWS S3 / CloudFront URLs for static assets (optional - falls back to local files)
NEXT_PUBLIC_FOUNDER_IMAGE_URL="https://makanview-images.s3.me-central-1.amazonaws.com/uploads/founder.jpeg"
NEXT_PUBLIC_LOGO_URL=""












